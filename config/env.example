# Instance name (used for container naming)
INSTANCE=op-and-chloe

# Host ports (bound to loopback by default; use SSH tunnel)
NOVNC_HOST=127.0.0.1
NOVNC_PORT=6080

# Worker OpenClaw gateway (bound to loopback; use SSH tunnel)
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=18789

# Guard OpenClaw gateway (Op — admin instance with SSH access)
GUARD_GATEWAY_HOST=127.0.0.1
GUARD_GATEWAY_PORT=18790

# Required: set strong tokens (worker + guard)
OPENCLAW_GATEWAY_TOKEN=change-me-worker
OPENCLAW_GUARD_GATEWAY_TOKEN=change-me-guard

# Bind-mount roots on the host (one folder per image)
OPENCLAW_STATE_DIR=/var/lib/openclaw/chloe/state
OPENCLAW_WORKSPACE_DIR=/var/lib/openclaw/chloe/workspace
OPENCLAW_GUARD_STATE_DIR=/var/lib/openclaw/guard/state
OPENCLAW_GUARD_WORKSPACE_DIR=/var/lib/openclaw/guard/workspace
BROWSER_CONFIG_DIR=/var/lib/openclaw/browser

# Optional: pin the browser container IP for stable CDP
DOCKER_SUBNET=172.31.0.0/24
BROWSER_IPV4=172.31.0.10

# Stack directory (for guard mount; setup.sh sets this when creating env)
OPENCLAW_STACK_DIR=/opt/op-and-chloe

# Daily compressed host backups for Chloe's workspace/config.
# Setup fills the default location as a sibling to OPENCLAW_STACK_DIR.
DAILY_BACKUPS_ENABLED=disabled
DAILY_BACKUPS_DIR=
DAILY_BACKUPS_RETENTION_COUNT=30

# Public static sites published from Chloe's workspace/sites/*
# Example: if SITES_BASE_DOMAIN=sites.example.com and sites/sites.json contains
# {"sites":[{"name":"hello","subdomain":"hello","root":"hello/dist"}]}, the site is served at
# https://hello.sites.example.com
SITES_ENABLED=disabled
SITES_BASE_DOMAIN=
# Bind published HTTP/HTTPS on the host. Use 0.0.0.0 when nothing else uses 443 on the box.
# If Tailscale is enabled, it often listens on port 443 on the tailnet IP and Docker cannot bind
# 0.0.0.0:443 — set both to your VPS's public IPv4 (e.g. 203.0.113.10) instead.
SITES_HTTP_HOST=0.0.0.0
SITES_HTTP_PORT=80
SITES_HTTPS_HOST=0.0.0.0
SITES_HTTPS_PORT=443
SITES_RECONCILE_INTERVAL=5
OPENCLAW_SITES_PROXY_CONFIG_DIR=/etc/openclaw/sites-proxy
OPENCLAW_SITES_PROXY_DATA_DIR=/var/lib/openclaw/sites-proxy/data
OPENCLAW_SITES_PROXY_STORAGE_DIR=/var/lib/openclaw/sites-proxy/config

# Optional: pin the OpenClaw image
# OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:main
